# Development only. Render must set DJANGO_ENV=production.
DJANGO_ENV=development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Blank uses SQLite ONLY in development. For PostgreSQL, use:
# postgresql://musu:musu_local_only@localhost:5432/musu
# Production requires a PostgreSQL URL (Neon: include ?sslmode=require).
DATABASE_URL=
