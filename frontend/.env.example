# Browser-visible, never put secrets in VITE_* variables.
# Local requests use Vite's proxy. Production: set the deployed backend URL
# including /api/v1, or configure a same-origin Vercel API rewrite first.
VITE_API_BASE_URL=/api/v1
# Used by the Vite development server only.
API_PROXY_TARGET=http://127.0.0.1:8000
